<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seamless Photo Dump</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #000;
            overflow-x: hidden;
        }
        .collage-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            grid-auto-rows: 150px;
            grid-auto-flow: dense;
            gap: 0; 
        }
        .collage-grid a {
            width: 100%;
            height: 100%;
            display: block;
            text-decoration: none;
        }
        .collage-grid img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .wide { grid-column: span 2; }
        .tall { grid-row: span 2; }
        .big  { grid-column: span 2; grid-row: span 2; }
    </style>
</head>
<body>

    <div class="collage-grid">
        <!-- Normal Size -->
        <a href="https://picsum.photos">
            <img src="https://picsum.photos" alt="Photo">
        </a>
        
        <!-- Tall Size -->
        <a class="tall" href="https://picsum.photos">
            <img src="https://picsum.photos" alt="Photo">
        </a>
        
        <!-- Wide Size -->
        <a class="wide" href="https://picsum.photos">
            <img src="https://picsum.photos" alt="Photo">
        </a>
        
        <!-- Big Size -->
        <a class="big" href="https://picsum.photos">
            <img src="https://picsum.photos" alt="Photo">
        </a>
    </div>

</body>
</html>
